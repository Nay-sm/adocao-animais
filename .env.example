# Neon, branch de desenvolvimento, conexão DIRETA (sem -pooler), usada nas migrations
DATABASE_URL_UNPOOLED=""

# Chave longa e secreta. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# No computador: http://localhost:3000 | Na Vercel: https://nome-do-projeto.vercel.app
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Token do Vercel Blob (o dono do projeto pega na Vercel e envia por mensagem privada)
BLOB_READ_WRITE_TOKEN=""